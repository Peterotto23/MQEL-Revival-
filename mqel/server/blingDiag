#!/usr/bin/env python3
"""Read-only check on the VPS: is the bling-drop patch really live?
Run from the repo root (the folder with server/):   python3 bling_diag.py [profile]
"""
import glob, json, os, subprocess, sys, time

profile = sys.argv[1] if len(sys.argv) > 1 else "new"
fmt = lambda t: time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(t))

print("== 1. code on disk has the PvP/PvE patch?")
checks = {"server/loot.py": "bling_drop_allowed", "server/attack.py": "pvp=castles.castle_type",
          "server/balance.py": '("Loot", "PvP")'}
for path, needle in checks.items():
    txt = open(path, encoding="utf-8", errors="replace").read()
    print(f"  {path}: {'OK' if needle in txt else 'MISSING (old code)'}  modified {fmt(os.path.getmtime(path))}")

print("== 2. running process vs. file times (python does not reload files)")
pids = subprocess.run(["pgrep", "-f", "server/game_server.py"], capture_output=True, text=True).stdout.split()
for pid in pids:
    try:
        start = os.stat(f"/proc/{pid}").st_ctime
        cwd = os.readlink(f"/proc/{pid}/cwd")
    except OSError:
        continue
    newer = [p for p in checks if os.path.getmtime(p) > start]
    print(f"  pid {pid} cwd {cwd} started {fmt(start)}")
    print("  ->", f"RESTART NEEDED, newer than process: {newer}" if newer else "started after the last edit")
if not pids:
    print("  no game_server.py process found")

print("== 3. balance.json (what the server loads at start)")
bpath = f"server/state/{profile}/balance.json"
try:
    b = json.load(open(bpath, encoding="utf-8"))
    v = b["Values"]
    print(f"  Enabled={v.get('Enabled')}  Loot={v.get('Loot')}  last change {b.get('Changed')}")
except Exception as e:
    print("  cannot read", bpath, "-", e)

print("== 4. ledger: loot blings credited (Source/Kind contains 'loot')")
total = 0
for p in glob.glob(f"server/state/{profile}/*.blings.jsonl"):
    for line in open(p, encoding="utf-8"):
        if "loot" in line.lower() and "boss" not in line.lower():
            total += 1
            last = (os.path.basename(p), line.strip())
print(f"  {total} loot entries" + (f", latest: {last}" if total else ""))

print("== 5. git")
for cmd in (["git", "log", "-1", "--format=%h %ci %s"], ["git", "status", "--short", "server/"]):
    r = subprocess.run(cmd, capture_output=True, text=True)
    print("  ", " ".join(cmd[1:3]), "->", (r.stdout or r.stderr).strip() or "(clean)")